{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 1025,
      "Tls": "None",
      "FromAddress": "noreply@incidenthub.local",
      "FromName": "IncidentHub",
      "PublicBaseUrl": "http://localhost:5173"
    },
    "Chat": {
      "Enabled": false
    }
  },
  "Sla": {
    "Defaults": {
      "Critical": { "AckMinutes": 15, "ResolveMinutes": 240, "EscalateAtPercent": 80 },
      "High": { "AckMinutes": 60, "ResolveMinutes": 480, "EscalateAtPercent": 80 },
      "Medium": { "AckMinutes": 240, "ResolveMinutes": 4320, "EscalateAtPercent": 80 },
      "Low": { "AckMinutes": 480, "ResolveMinutes": 7200, "EscalateAtPercent": 80 }
    }
  }
}
